{
  "name": "sunrise",
  "private": true,
  "version": "0.1.0",
  "description": "Training log for Monte Adamello, July 2027",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"pnpm --filter web dev\" \"pnpm --filter api dev\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web --if-present lint",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "db:generate": "pnpm --filter api db:generate",
    "db:push": "pnpm --filter api db:push",
    "db:studio": "pnpm --filter api db:studio"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  }
}
